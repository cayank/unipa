{
  "name": "unipa",
  "version": "1.2.0",
  "description": "Takes a core dump of an iOS app running on macOS, locates the encrypted Mach-O regions, extracts them from memory, patches copies of the executables, and produces an IPA containing `Payload/*.app`.",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "unipa": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "clean:cores": "bun run scripts/clean-cores.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "keywords": [
    "ios",
    "macos",
    "ipa",
    "fairplay",
    "sideloadly"
  ],
  "author": "Çayan K. <contact@cayan.dev>",
  "license": "MIT"
}
